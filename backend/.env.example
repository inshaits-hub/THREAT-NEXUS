# ---------------------------------------------------------------------------
# Copy to .env and adjust:   cp .env.example .env
#
# .env is gitignored (it may hold a real SECRET_KEY). Every value below is the
# built-in default, so the app also runs with no .env at all.
# Relative paths resolve against backend/, not the current working directory.
# ---------------------------------------------------------------------------

# SQLite file. Parent folders are created automatically.
DB_PATH=instance/logs.db

# Folder for generated HTML/JSON executive reports.
REPORTS_DIR=reports

# POST /api/v1/upload size cap, in megabytes. Exceeding it returns HTTP 413.
MAX_UPLOAD_MB=16

# Brute-force rule: alert when failed SSH logins from one IP EXCEED this
# many inside 60s. Overridable per run with the CLI --threshold flag.
ANALYSIS_THRESHOLD=5

# API bind address. Keep 127.0.0.1 unless you also set FLASK_ENV=production.
HOST=127.0.0.1
PORT=5000

# development  -> Werkzeug reloader + interactive debugger (local only)
# production   -> no debugger, no reloader
FLASK_ENV=development

# Change this before deploying anywhere reachable from the network.
SECRET_KEY=dev-secret

# --- ThreatNexus additions (values = built-in defaults) ---
# Scoring time-decay rate per hour (0.05 ~ 14h half-life).
RISK_DECAY_LAMBDA=0.05
# Socket.IO CORS origin(s) for live threat_alert streaming.
SOCKETIO_ALLOWED_ORIGINS=*
# SSH decoy trap: off unless 1/true/yes/on. It records the source
# address and closes the connection - never speaks SSH, never executes.
SSH_DECOY_ENABLED=0
SSH_DECOY_PORT=2222
SSH_DECOY_HOST=0.0.0.0
